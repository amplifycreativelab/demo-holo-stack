---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import GlassPanel from "../../components/GlassPanel.astro";
import { Mail, MessageSquare, MapPin, Send } from "lucide-astro";

const contactInfo = [
    { icon: Mail, label: "Studio", val: "amplifycreativelab.com" },
    {
        icon: MessageSquare,
        label: "Notes",
        val: "Use the form on this page",
    },
    { icon: MapPin, label: "Status", val: "Non-indexed concept demo" },
];
---

<MainLayout title="Contact - Request Substrate Demo">
    <Header slot="header" />

    <section class="pt-40 pb-20 px-6">
        <div class="max-w-7xl mx-auto">
            <div class="grid lg:grid-cols-2 gap-20">
                <div>
                    <h1 class="text-5xl md:text-6xl font-bold mb-8 italic">
                        Let's build the <span class="text-holo-a">Future</span>.
                    </h1>
                    <p class="text-text-muted text-xl mb-12 leading-relaxed">
                        Ready to deploy your first neural substrate? Our
                        architecture team is standing by to help you scale.
                    </p>

                    <div class="space-y-10">
                        {
                            contactInfo.map((item) => (
                                <div class="flex items-center gap-6">
                                    <div class="w-12 h-12 rounded-xl glass flex items-center justify-center border-holo-a/30">
                                        <item.icon class="w-6 h-6 text-holo-a" />
                                    </div>
                                    <div>
                                        <div class="text-[10px] uppercase tracking-widest text-text-muted mb-1">
                                            {item.label}
                                        </div>
                                        <div class="font-bold text-lg">
                                            {item.val}
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <GlassPanel
                    intensity="strong"
                    class="p-12 relative overflow-hidden"
                >
                    <div
                        class="absolute -top-24 -left-24 w-64 h-64 bg-holo-a/10 blur-[100px]"
                    >
                    </div>
                    <form class="space-y-6 relative z-10">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label
                                    class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1"
                                    >First Name</label
                                >
                                <input
                                    type="text"
                                    class="w-full bg-white/5 border border-glass-edge rounded-xl px-4 py-3 focus:outline-none focus:border-holo-a transition-colors"
                                    placeholder="Isaac"
                                />
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1"
                                    >Last Name</label
                                >
                                <input
                                    type="text"
                                    class="w-full bg-white/5 border border-glass-edge rounded-xl px-4 py-3 focus:outline-none focus:border-holo-a transition-colors"
                                    placeholder="Clarke"
                                />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label
                                class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1"
                                >Substrate Use Case</label
                            >
                            <select
                                class="w-full bg-white/5 border border-glass-edge rounded-xl px-4 py-3 focus:outline-none focus:border-holo-a transition-colors appearance-none text-text-muted"
                            >
                                <option>Global Edge Delivery</option>
                                <option>Distributed Database</option>
                                <option>Neural Network Acceleration</option>
                                <option>Quantum Security Audit</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label
                                class="text-xs font-bold uppercase tracking-widest text-text-muted ml-1"
                                >Message</label
                            >
                            <textarea
                                class="w-full bg-white/5 border border-glass-edge rounded-xl px-4 py-6 focus:outline-none focus:border-holo-a transition-colors h-32 resize-none"
                                placeholder="Tell us about your architectural requirements..."
                            ></textarea>
                        </div>
                        <button
                            class="w-full py-4 bg-holo-a text-white font-bold rounded-2xl shadow-lg shadow-holo-a/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3 group"
                        >
                            Send Request <Send
                                class="w-4 h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            />
                        </button>
                        <p class="text-[10px] text-text-muted text-center pt-4">
                            By sending this request, you agree to our processing
                            of holographic telemetry data as outlined in our
                            privacy policy.
                        </p>
                    </form>
                </GlassPanel>
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</MainLayout>
