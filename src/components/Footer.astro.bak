---
const baseUrl = import.meta.env.BASE_URL;
import { Github, Twitter, Linkedin } from "lucide-astro";
import HoloLogo from "./HoloLogo.astro";

const links = {
    Product: ["Features", "Integrations", "Pricing", "Security", "Roadmap"],
    Company: ["About", "Careers", "Customers", "Contact"],
    Legal: ["Privacy", "Terms", "Security", "Cookies"],
};
---

<footer
    class="mt-32 border-t border-glass-edge py-20 px-6 relative overflow-hidden"
>
    <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-12">
            <div class="col-span-2">
                <a href={baseUrl} class="mb-6 block group">
                    <HoloLogo class="!gap-3" />
                </a>
                <p
                    class="text-text-muted text-sm max-w-xs leading-relaxed mb-8"
                >
                    The next generation of SaaS management. Engineered for
                    optics, designed for performance, built for the future.
                </p>
                <div class="flex items-center gap-4">
                    <a
                        href="#"
                        class="text-text-muted hover:text-holo-a transition-colors"
                        ><Twitter class="w-5 h-5" /></a
                    >
                    <a
                        href="#"
                        class="text-text-muted hover:text-holo-a transition-colors"
                        ><Github class="w-5 h-5" /></a
                    >
                    <a
                        href="#"
                        class="text-text-muted hover:text-holo-a transition-colors"
                        ><Linkedin class="w-5 h-5" /></a
                    >
                </div>
            </div>

            {
                Object.entries(links).map(([title, items]) => (
                    <div>
                        <h4 class="font-display font-bold text-sm mb-6 uppercase tracking-wider">
                            {title}
                        </h4>
                        <ul class="space-y-4">
                            {items.map((item) => (
                                <li>
                                    <a
                                        href="#"
                                        class="text-sm text-text-muted hover:text-text-primary transition-colors"
                                    >
                                        {item}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-20 pt-8 border-t border-glass-edge flex flex-col md:flex-row justify-between items-center gap-4"
        >
            <p class="text-xs text-text-muted">
                © 2025 HoloStack. All rights reserved. Concept demo.
            </p>
            <div class="flex items-center gap-6">
                <a
                    href="#"
                    class="text-xs text-text-muted hover:text-text-primary"
                    >Status</a
                >
                <a
                    href="#"
                    class="text-xs text-text-muted hover:text-text-primary"
                    >System Log</a
                >
            </div>
        </div>
    </div>
</footer>
