---
import HoloButton from "./HoloButton.astro";
import HoloLogo from "./HoloLogo.astro";

const baseUrl = import.meta.env.BASE_URL;

const navItems = [
    { name: "Features", href: `${baseUrl}features` },
    { name: "Integrations", href: `${baseUrl}integrations` },
    { name: "Pricing", href: `${baseUrl}pricing` },
    { name: "Security", href: `${baseUrl}security` },
];
---

<header
    transition:persist="site-header"
    class="fixed top-0 left-0 right-0 z-50 px-6 py-4"
>
    <div class="max-w-7xl mx-auto">
        <nav
            class="glass px-6 py-3 rounded-full flex items-center justify-between relative z-50"
        >
            <a href={baseUrl} class="group">
                <HoloLogo />
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-8">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            data-astro-prefetch
                            class="text-sm font-medium text-text-muted hover:text-text-primary transition-colors"
                        >
                            {item.name}
                        </a>
                    ))
                }
            </div>

            <div class="flex items-center gap-4">
                <a
                    href={`${baseUrl}contact`}
                    data-astro-prefetch
                    class="hidden sm:block text-sm font-medium text-text-muted hover:text-text-primary transition-colors"
                >
                    Log in
                </a>
                <HoloButton
                    href={`${baseUrl}contact`}
                    data-astro-prefetch="load"
                    class="text-xs px-5 py-2 hidden sm:flex"
                >
                    Start trial
                </HoloButton>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-btn"
                    class="md:hidden text-text-primary hover:text-accent transition-colors p-1"
                    aria-label="Toggle menu"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-6 h-6"
                    >
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div
            id="mobile-menu"
            class="fixed inset-0 z-40 bg-night/95 backdrop-blur-xl transform translate-x-full transition-transform duration-300 md:hidden flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none"
        >
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        data-astro-prefetch
                        class="text-2xl font-medium text-text-primary hover:text-accent transition-colors"
                    >
                        {item.name}
                    </a>
                ))
            }
            <div class="flex flex-col items-center gap-6 mt-8">
                <a
                    href={`${baseUrl}contact`}
                    data-astro-prefetch
                    class="text-lg font-medium text-text-muted hover:text-text-primary transition-colors"
                >
                    Log in
                </a>
                <HoloButton
                    href={`${baseUrl}contact`}
                    data-astro-prefetch="load"
                    class="text-sm px-8 py-3"
                >
                    Start trial
                </HoloButton>
            </div>
        </div>
    </div>
</header>

<script>
    const closeMobileMenu = (menu) => {
        menu.classList.add("translate-x-full", "opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
    };

    const openMobileMenu = (menu) => {
        menu.classList.remove(
            "translate-x-full",
            "opacity-0",
            "pointer-events-none",
        );
        document.body.style.overflow = "hidden";
    };

    document.addEventListener("astro:page-load", () => {
        const btn = document.getElementById("mobile-menu-btn");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;

        // Always reset state on navigation (important when the header persists)
        closeMobileMenu(menu);

        // Bind listeners once when persisted across transitions
        if (btn.dataset.menuBound === "true") return;
        btn.dataset.menuBound = "true";

        btn.addEventListener("click", () => {
            const isOpen = !menu.classList.contains("translate-x-full");
            if (isOpen) closeMobileMenu(menu);
            else openMobileMenu(menu);
        });

        menu.addEventListener("click", (e) => {
            if (e.target instanceof Element && e.target.closest("a")) {
                closeMobileMenu(menu);
            }
        });
    });
</script>
